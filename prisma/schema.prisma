// Mochibo database. Money is stored as BigInt centi-credits (1 CR = 100).
// Migrations live in prisma/migrations; the VPS applies them with `prisma migrate deploy`.
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Tone {
  FRIENDLY
  PROFESSIONAL
  CONCISE
}

// English only (owner decision, October 2026).
enum Lang {
  EN
}

enum Tier {
  FREE
  HOLDER
  BUILDER
  WHALE
}

enum RunStatus {
  PENDING
  RUNNING
  DONE
  FAILED
  REFUNDED
}

enum LedgerType {
  WELCOME // one-time free credits for a new wallet
  TOPUP
  RUN_DEBIT
  RUN_CREDIT
  REFUND
  CLAIM_REQUEST
  CLAIM_REVERT
  ADMIN_GRANT
  ADJUST
  BATTLE_DEBIT // starting an agent battle
  BATTLE_REFUND // a battle that failed to generate
  BATTLE_PRIZE // the winning agent's creator
}

enum BattleMode {
  ROAST
  DEBATE
}

enum BattleStatus {
  RUNNING // the AI is writing it
  OPEN // finished, voting is open
  CLOSED // voting ended, winner settled
  FAILED // refunded
}

enum DepositStatus {
  SEEN
  CONFIRMED
  CREDITED
}

enum ClaimStatus {
  PENDING
  SUBMITTED
  PAID
  EXPIRED
}

model User {
  id            String        @id @default(cuid())
  wallet        String        @unique // lowercased 0x address
  balance       BigInt        @default(0) // centi-credits, cached from ledger
  tier          Tier          @default(FREE)
  tierCheckedAt DateTime?
  isAdmin       Boolean       @default(false)
  createdAt     DateTime      @default(now())
  agents        Agent[]
  runs          Run[]         @relation("Runner")
  ledger        LedgerEntry[]
  claims        Claim[]
  ratings       Rating[]
  battles       Battle[]
  battleVotes   BattleVote[]
}

model Agent {
  id           String    @id @default(cuid())
  slug         String    @unique
  ownerId      String
  owner        User      @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  // Base character the look started from (one of the 12), for the studio roster and the role label.
  baseId       String    @default("juni") @db.VarChar(20)
  name         String    @db.VarChar(32)
  instructions String    @db.VarChar(2000) // private: owner and AI provider only
  tone         Tone      @default(FRIENDLY)
  lang         Lang      @default(EN)
  character    Json // validated CharacterConfig
  skills       String[] // max 4, ids from the fixed skill list
  price        Int       @default(0) // whole CR, 0 to 500
  published    Boolean   @default(false)
  publishedAt  DateTime?
  thumbnailUrl String?
  runsCount    Int       @default(0)
  // Level points: 1 per other wallet per day that runs it, plus battle wins (packages/shared/src/levels.ts).
  xp           Int       @default(0)
  battleWins   Int       @default(0)
  earnedTotal  BigInt    @default(0) // centi-credits
  ratingSum    Int       @default(0)
  ratingCount  Int       @default(0)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  // Deleting hides the agent; runs and earnings keep their history.
  deletedAt    DateTime?
  runs         Run[]
  ratings      Rating[]

  @@index([published, runsCount])
  @@index([ownerId])
}

model Run {
  id         String    @id @default(cuid())
  // Null for studio runs and example agents until agents are stored (phase 2).
  agentId    String?
  agent      Agent?    @relation(fields: [agentId], references: [id], onDelete: Cascade)
  // "studio", "example:<id>" or "agent"
  source     String    @default("agent")
  runnerId   String
  runner     User      @relation("Runner", fields: [runnerId], references: [id])
  skillId    String
  // Not stored during the preview: the privacy page promises tasks and answers are not kept.
  task       String?   @db.VarChar(4000)
  output     String?
  status     RunStatus @default(PENDING)
  cost       BigInt // centi-credits charged to the runner
  creatorNet BigInt    @default(0)
  fee        BigInt    @default(0)
  model      String?
  tokensIn   Int?
  tokensOut  Int?
  error      String?
  createdAt  DateTime  @default(now())
  finishedAt DateTime?
  rating     Rating?

  @@index([agentId, createdAt])
  @@index([runnerId, createdAt])
}

model LedgerEntry {
  id             String     @id @default(cuid())
  userId         String
  user           User       @relation(fields: [userId], references: [id])
  type           LedgerType
  amount         BigInt // signed centi-credits
  balanceAfter   BigInt
  refType        String? // "run" | "battle" | "deposit" | "claim" | "admin"
  refId          String?
  idempotencyKey String     @unique
  memo           String?
  createdAt      DateTime   @default(now())

  @@index([userId, createdAt])
}

model Deposit {
  id          String        @id @default(cuid())
  txHash      String
  logIndex    Int
  wallet      String
  amountRaw   String // USDG base units
  credits     BigInt // centi-credits
  blockNumber BigInt
  status      DepositStatus @default(SEEN)
  createdAt   DateTime      @default(now())

  @@unique([txHash, logIndex])
  @@index([wallet])
}

model Claim {
  id        String      @id @default(cuid())
  userId    String
  user      User        @relation(fields: [userId], references: [id])
  credits   BigInt // centi-credits debited
  amountRaw String // USDG base units in the voucher
  nonce     String      @unique
  signature String
  expiresAt DateTime
  status    ClaimStatus @default(PENDING)
  txHash    String?
  createdAt DateTime    @default(now())

  @@index([userId, createdAt])
}

model Rating {
  id        String   @id @default(cuid())
  runId     String   @unique
  run       Run      @relation(fields: [runId], references: [id], onDelete: Cascade)
  agentId   String
  agent     Agent    @relation(fields: [agentId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  stars     Int // 1 to 5
  createdAt DateTime @default(now())

  @@index([agentId])
}

// Two agents battle (a roast, or a debate on a topic); people vote for 24 hours. Fighters are
// snapshotted (name, look) so the battle page still works if an agent changes or is deleted.
// Instructions are never stored here: lines are public.
model Battle {
  id         String       @id @default(cuid())
  slug       String       @unique
  starterId  String
  starter    User         @relation(fields: [starterId], references: [id], onDelete: Cascade)
  mode       BattleMode
  topic      String       @db.VarChar(200)
  aAgentId   String? // stored agent, or null for an example agent
  aExampleId String?      @db.VarChar(20)
  aName      String       @db.VarChar(32)
  aCharacter Json
  aSlug      String? // public page of a published agent
  aBaseId    String       @default("juni") @db.VarChar(20)
  aThumb     String? // portrait URL of a published agent
  bAgentId   String?
  bExampleId String?      @db.VarChar(20)
  bName      String       @db.VarChar(32)
  bCharacter Json
  bSlug      String?
  bBaseId    String       @default("juni") @db.VarChar(20)
  bThumb     String? // portrait URL of a published agent
  lines      Json         @default("[]") // [{ side: "a" | "b", text }]
  status     BattleStatus @default(RUNNING)
  cost       BigInt // centi-credits
  votesA     Int          @default(0)
  votesB     Int          @default(0)
  winner     String? // "a", "b" or "tie"
  endsAt     DateTime?
  settledAt  DateTime?
  createdAt  DateTime     @default(now())
  votes      BattleVote[]

  @@index([status, endsAt])
  @@index([createdAt])
}

model BattleVote {
  battleId  String
  battle    Battle   @relation(fields: [battleId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  side      String   @db.VarChar(1)
  createdAt DateTime @default(now())

  @@id([battleId, userId])
}
