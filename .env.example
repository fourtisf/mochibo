# ============ Web (Next.js) ============
NEXT_PUBLIC_APP_NAME=Orbis
NEXT_PUBLIC_APP_URL=https://your-domain.com
NEXT_PUBLIC_ENABLE_WEB_SEARCH=false  # Match ENABLE_WEB_SEARCH below; the run output says when research does not browse
NEXT_PUBLIC_CHAIN_ID=              # Robinhood Chain mainnet id. Take it from https://docs.robinhood.com/chain
NEXT_PUBLIC_RPC_URL=               # From official docs
NEXT_PUBLIC_EXPLORER_URL=          # Optional, from official docs
NEXT_PUBLIC_TOKEN_ADDRESS=         # ORBIS token. Leave empty until live
NEXT_PUBLIC_CREDIT_VAULT_ADDRESS=
NEXT_PUBLIC_USDG_ADDRESS=          # From official sources
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=  # Free at cloud.reown.com. Without it only browser-extension wallets work

# ============ API (Fastify) ============
PORT=4000
HOST=127.0.0.1
NODE_ENV=production
APP_URL=https://your-domain.com    # Its host is the SIWE domain; its origin is the only allowed Origin for writes
DATABASE_URL=postgresql://orbis:CHANGE_ME@localhost:5432/orbis
REDIS_URL=redis://:CHANGE_ME@localhost:6379  # Empty = in-memory store (development only)
SESSION_SECRET=                    # 64+ random chars
CORS_ORIGIN=https://your-domain.com
ADMIN_WALLETS=                     # comma-separated lowercase addresses

# AI (server only, never in the browser). Provider: OpenRouter (owner's choice, October 2026).
OPENROUTER_API_KEY=                # openrouter.ai > Keys. Set a credit limit on the key there.
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
AI_MODEL=                          # Model id from openrouter.ai/models, e.g. anthropic/claude-haiku-4.5. Check price per run.
AI_MAX_TOKENS=700
AI_TIMEOUT_MS=60000
ENABLE_WEB_SEARCH=false            # true adds OpenRouter web search to the Web research skill (paid)

# Preview run limits (no credits ledger yet; runs need a signed-in wallet)
RUNS_PER_WALLET_PER_DAY=20
RUNS_PER_DAY_TOTAL=500
SESSION_DAYS=7

# Economics (credits are whole CR in config, stored as centi-credits in DB)
RUN_COST_CR=5
MAX_PRICE_CR=500
PLATFORM_FEE_BPS=500               # 5%. Tier discounts live in packages/shared/config.ts
CREDITS_PER_USDG=100
RATE_LIMIT_RUNS_PER_MIN=6

# Chain
CHAIN_ID=
RPC_URL=
USDG_ADDRESS=
USDG_DECIMALS=
CREDIT_VAULT_ADDRESS=
CLAIM_SIGNER_PRIVATE_KEY=          # Authorises claims only, vault enforces caps. Never commit, never log
CLAIM_VOUCHER_TTL_MIN=30
DEPOSIT_CONFIRMATIONS=
TOKEN_ADDRESS=
REWARDS_ENABLED=false

# Storage
UPLOAD_DIR=/var/www/orbis/uploads
PUBLIC_UPLOAD_URL=https://your-domain.com/uploads
