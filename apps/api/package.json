{
  "name": "@orbis/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/build.mjs --watch",
    "build": "pnpm db:generate && node scripts/build.mjs",
    "start": "node dist/server.cjs",
    "typecheck": "pnpm db:generate >/dev/null && tsc --noEmit",
    "lint": "eslint src",
    "test": "vitest run",
    "db:generate": "prisma generate --schema ../../prisma/schema.prisma",
    "db:migrate": "prisma migrate deploy --schema ../../prisma/schema.prisma",
    "db:dev": "prisma migrate dev --schema ../../prisma/schema.prisma"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@orbis/shared": "workspace:*",
    "fastify": "^5.6.1",
    "ioredis": "^5.8.2",
    "viem": "^2.57.2",
    "zod": "^3.23.8",
    "@prisma/client": "6.19.3"
  },
  "devDependencies": {
    "@types/node": "^20.16.0",
    "esbuild": "^0.25.12",
    "typescript": "~5.6.3",
    "vitest": "^3.2.4",
    "prisma": "6.19.3"
  }
}
